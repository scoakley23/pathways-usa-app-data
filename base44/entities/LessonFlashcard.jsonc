{
  "name": "LessonFlashcard",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID of the associated lesson"
    },
    "term": {
      "type": "string",
      "description": "Key term or concept"
    },
    "definition": {
      "type": "string",
      "description": "Definition or explanation of the term"
    },
    "example": {
      "type": "string",
      "description": "Example or additional context"
    }
  },
  "required": [
    "lesson_id",
    "term",
    "definition"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
