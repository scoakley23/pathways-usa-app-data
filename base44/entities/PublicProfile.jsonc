{
  "name": "PublicProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "badges_count": {
      "type": "number",
      "default": 0
    },
    "invite_code": {
      "type": "string",
      "description": "Unique code for students to join this tutor's class"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "student",
        "tutor"
      ],
      "default": "student",
      "description": "User's selected role in the app"
    },
    "representative_data": {
      "type": "object",
      "description": "Cached elected officials' names from the representative lookup (address is never stored)"
    }
  },
  "required": [
    "user_email",
    "display_name"
  ]
}