{
  "name": "User",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "User's public display name"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Gamification points"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of earned badge IDs"
    },
    "max_streak": {
      "type": "number",
      "default": 0,
      "description": "Highest daily streak achieved"
    },
    "tutor_profile": {
      "type": "object",
      "description": "The learner's AI tutor settings. Not sensitive. The explanation language is the app language (stored on the device), not here.",
      "properties": {
        "name": { "type": "string", "description": "Tutor name, max 20 characters. Default: Vía" },
        "avatar": { "type": "string", "enum": ["a1", "a2", "a3", "a4", "a5", "a6"] },
        "tone": { "type": "string", "enum": ["warm", "direct", "coach", "officer"] },
        "english_mix": { "type": "string", "enum": ["mostly_mine", "half", "mostly_english"] }
      }
    },
    "skill_levels": {
      "type": "object",
      "description": "Quick check results: one level per skill and the date. No answers, transcripts, or per-question results are stored.",
      "properties": {
        "civics": { "type": ["string", "null"], "enum": ["strong", "getting_there", "start_here", null] },
        "reading": { "type": ["string", "null"], "enum": ["strong", "getting_there", "start_here", null] },
        "writing": { "type": ["string", "null"], "enum": ["strong", "getting_there", "start_here", null] },
        "speaking": { "type": ["string", "null"], "enum": ["strong", "getting_there", "start_here", null] },
        "checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "program_code": {
      "type": ["string", "null"],
      "description": "Pilot: a partner organization's program code (e.g. HOUSTON-PILOT). Optional. Not the tutor invite code."
    },
    "state": {
      "type": ["string", "null"],
      "description": "Pilot: two-letter U.S. state or territory code, or prefer_not. Optional. Never a zip code or city."
    },
    "checkin_email_reminders": {
      "type": "boolean",
      "default": false,
      "description": "Pilot: the learner asked for a short email reminder at 3, 6 and 12 months. Off unless they turn it on."
    },
    "pilot_id": {
      "type": ["string", "null"],
      "description": "Pilot: a random ID made once, used only in exports instead of the email."
    },
    "checkins_stopped": {
      "type": "boolean",
      "default": false,
      "description": "Pilot: the learner chose 'Don't ask me again'. No more check-ins or reminder emails."
    },
    "reminder_language": {
      "type": ["string", "null"],
      "description": "Pilot: the app language code (e.g. es) for reminder emails, saved only while reminders are on."
    },
    "pilot_test_months_ago": {
      "type": ["number", "null"],
      "description": "Pilot testing, admins only: pretend sign-up was this many months ago. Ignored for non-admins."
    },
    "app_language": {
      "type": ["string", "null"],
      "description": "Pilot: the app language code (e.g. es), saved once a day with the activity date, for 'Reach by language'."
    },
    "pilot_intro_seen": {
      "type": "boolean",
      "default": false,
      "description": "Pilot: the learner has seen the 'Help us improve Pathways' screen (answered or skipped)."
    }
  },
  "required": [
    "display_name"
  ]
}