{
  "name": "TutorRelationship",
  "type": "object",
  "properties": {
    "tutor_email": {
      "type": "string",
      "description": "Email of the tutor"
    },
    "student_email": {
      "type": "string",
      "description": "Email of the student"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "rejected"
      ],
      "default": "pending"
    },
    "created_by": {
      "type": "string",
      "description": "Email of person who created the relationship (tutor or student)"
    },
    "requested_by": {
      "type": "string",
      "description": "Email of the person who sent the request; set only by the tutor-link function"
    }
  },
  "required": [
    "tutor_email",
    "student_email"
  ],
  "rls": {
    "create": false,
    "read": { "$or": [{ "data.tutor_email": "{{user.email}}" }, { "data.student_email": "{{user.email}}" }] },
    "update": false,
    "delete": { "$or": [{ "data.tutor_email": "{{user.email}}" }, { "data.student_email": "{{user.email}}" }] }
  }
}
