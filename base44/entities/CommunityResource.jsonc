{
  "name": "CommunityResource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "legal",
        "esl",
        "citizenship_class",
        "uscis",
        "library",
        "other"
      ],
      "default": "other"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "legal",
          "esl",
          "citizenship_class",
          "uscis",
          "library",
          "other"
        ]
      },
      "description": "Everything the place offers (includes category). A place shows under each of these filters."
    },
    "address": {
      "type": "string",
      "description": "Public street address of the place (never a learner's address)"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "Two-letter state code"
    },
    "zip": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "location_precision": {
      "type": "string",
      "enum": [
        "exact",
        "zip"
      ],
      "default": "exact",
      "description": "\"zip\" means the pin sits at the center of the ZIP code, not the building"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "https link to the place's public logo (e.g. its National Literacy Directory logo). Loaded only when a learner opens the place's summary."
    },
    "hours": {
      "type": "string",
      "description": "Opening hours as the source lists them"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost": {
      "type": "string",
      "enum": [
        "",
        "free",
        "low_cost",
        "varies"
      ],
      "default": ""
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where this listing came from, e.g. \"DOJ EOIR Recognized Organizations roster\""
    },
    "source_url": {
      "type": "string"
    },
    "last_verified": {
      "type": "string",
      "description": "Date (YYYY-MM-DD) an admin last checked this listing"
    },
    "external_id": {
      "type": "string",
      "description": "Source id, e.g. \"nld:205491\", \"doj:<org>|<address>\", \"uscis:boston-ma\". Lets re-imports update the same place."
    },
    "relevance_note": {
      "type": "string",
      "description": "Why an import hid or flagged this place (e.g. \"Children's program\"). Admin only; not shown to learners."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Hidden from learners when false"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}