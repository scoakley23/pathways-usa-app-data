{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user receiving the notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "request",
        "assignment",
        "message",
        "system",
        "alert"
      ],
      "default": "system"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string",
      "description": "Optional relative URL to redirect to"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "title",
    "message"
  ],
  "rls": {
    "create": { "created_by": "{{user.email}}" },
    "read": { "data.user_email": "{{user.email}}" },
    "update": { "data.user_email": "{{user.email}}" },
    "delete": { "data.user_email": "{{user.email}}" }
  }
}
