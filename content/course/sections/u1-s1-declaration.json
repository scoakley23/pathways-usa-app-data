      "steps": {
        "listen": {
          "explanationKey": "What founding document said the American colonies were free from Britain?",
          "facts": [
            "Long ago, the American colonies were ruled by Britain.",
            "On July 4, 1776, the Declaration of Independence said the colonies were free from Britain. We remember this day on Independence Day.",
            "It also says all people are created equal and have rights that no one can take away."
          ],
          "newWords": [
            {
              "word": "colony",
              "meaning": "a place ruled by a country far away"
            },
            {
              "word": "declaration",
              "meaning": "an important statement made in public"
            },
            {
              "word": "independence",
              "meaning": "being free from another country's control"
            }
          ]
        },
        "teachBack": {
