      "steps": {
        "listen": {
          "explanationKey": "What is the highest court in the United States?",
          "facts": [
            "The Supreme Court is the highest court in the United States.",
            "The Supreme Court and the other federal courts are the judicial branch."
          ],
          "newWords": [
            {
              "word": "court",
              "meaning": "a place where judges decide questions about the law"
            },
            {
              "word": "Supreme Court",
              "meaning": "the highest court in the United States"
