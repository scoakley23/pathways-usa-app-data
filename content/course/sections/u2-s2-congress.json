      "steps": {
        "listen": {
          "explanationKey": "What part of the federal government writes laws?",
          "facts": [
            "Congress is the legislative branch of the federal government.",
            "Congress writes the laws for the whole country.",
            "Congress can declare war and makes the federal budget."
          ],
          "newWords": [
            {
              "word": "Congress",
              "meaning": "the group of people who write the country's laws"
            },
            {
              "word": "legislative branch",
              "meaning": "the part of the government that makes laws"
            },
            {
              "word": "budget",
              "meaning": "a plan for how to spend money"
            }
          ]
        },
        "teachBack": {
          "questionId": "6ad16ecf6a9c603911f9de28"
        },
        "readIt": {
          "sentence": "What does Congress do?",
          "words": [
            "What",
            "does",
            "Congress",
            "do"
