    {
      "id": "u2-s3-l1",
      "title": "Four-year terms",
      "status": "draft",
      "questionIds": [
        "6ad16ecf6a9c603911f9de3a",
        "6ad16ecf6a9c603911f9de3b"
      ],
      "steps": {
        "listen": {
          "explanationKey": "The President of the United States is elected for how many years?",
          "facts": [
            "Americans elect a President every four years.",
            "A President can serve only two terms. This rule is in the 22nd Amendment.",
            "The two terms do not have to be back to back. A President can serve one term, lose an election, and win again later. That is still two terms.",
            "The rule keeps a president from becoming too powerful."
          ],
          "newWords": [
            {
              "word": "term",
              "meaning": "the number of years a person serves in a job"
            },
            {
              "word": "amendment",
              "meaning": "a change or addition to the Constitution"
            }
          ]
        },
        "teachBack": {
          "questionId": "6ad16ecf6a9c603911f9de3a"
        },
        "readIt": {
          "sentence": "When do we vote for President?",
          "words": [
            "When",
            "do",
            "we",
            "vote",
            "for",
            "President"
          ]
        },
        "writeIt": {
          "sentence": "We vote for President in November.",
          "distractorWords": [
            "Congress",
            "June",
            "red"
          ]
        },
        "officer": {
          "questionId": "6ad16ecf6a9c603911f9de3b"
        }
      }
    },
    {
      "id": "u2-s3-l2",
      "title": "What the President does",
      "status": "reviewed",
      "questionIds": [
        "6ad16ecf6a9c603911f9de3f",
        "6ad16ecf6a9c603911f9de40"
      ],
      "steps": {
        "listen": {
          "explanationKey": "Name one power of the president.",
          "facts": [
            "The President signs bills into law and can veto bills.",
            "The President is the Commander in Chief of the military.",
            "The President also appoints federal judges."
          ],
          "newWords": [
            {
              "word": "power",
              "meaning": "a right to do something"
            },
            {
              "word": "Commander in Chief",
              "meaning": "the leader of all the armed forces"
            }
          ]
        },
        "teachBack": {
