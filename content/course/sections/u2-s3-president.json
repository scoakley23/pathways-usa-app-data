    {
      "id": "u2-s3-l3",
      "title": "Electing the President",
      "status": "draft",
      "questionIds": [
        "6ad16ecf6a9c603911f9de47"
      ],
      "steps": {
        "listen": {
          "explanationKey": "Why is the Electoral College important?",
          "facts": [
            "The Electoral College decides who is elected President.",
            "When you vote for President, you are really choosing your state's electors. Electors are people who vote for President for their state.",
            "Each state gets as many electors as it has members of Congress: its two senators plus its representatives. Washington, D.C. gets 3. There are 538 electors in all.",
            "In most states, the candidate who gets the most votes wins all of that state's electors. To become President, a candidate needs 270 electoral votes.",
            "The Electoral College is a compromise between a vote of the people and a choice by Congress."
          ],
          "newWords": [
            {
              "word": "elector",
              "meaning": "a person chosen to vote for President for a state"
            },
            {
              "word": "compromise",
              "meaning": "an agreement where each side gets part of what it wants"
            }
          ]
        },
        "teachBack": {
          "questionId": "6ad16ecf6a9c603911f9de47"
        },
        "readIt": {
          "sentence": "Who elects the President?",
          "words": [
            "Who",
            "elects",
            "the",
            "President"
          ]
        },
        "writeIt": {
          "sentence": "Citizens vote for President.",
          "distractorWords": [
            "Congress",
            "Mexico",
            "white"
          ]
        },
        "officer": {
          "questionId": "6ad16ecf6a9c603911f9de47"
        }
      }
    },
