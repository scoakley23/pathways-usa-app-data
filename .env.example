# Copy the lines you need into your own .env file (never commit .env).

# Base44 (the app's data until Standalone Step 3)
VITE_BASE44_APP_ID=
VITE_BASE44_BACKEND_URL=

# Supabase (Standalone Step 2). Both are PUBLIC values from Supabase
# dashboard -> Project Settings -> API: the Project URL and the anon
# (publishable) key. Never put the service-role (secret) key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The sign-in switch: "supabase" uses the 6-digit email code. Leave it empty
# to keep Base44's sign-in (needed until Step 3 moves the data).
VITE_AUTH_PROVIDER=
